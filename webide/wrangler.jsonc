{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "overpy-webide",
    "main": "server/index.ts",
    "compatibility_date": "2026-09-01",
    "assets": {
        // Built by `vite build`.
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "overpy-webide",
            // Replace with the id printed by `pnpm exec wrangler d1 create overpy-webide` (see README.md).
            // Local development works with the placeholder.
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations"
        }
    ],
    "observability": {
        "enabled": true
    }
}
